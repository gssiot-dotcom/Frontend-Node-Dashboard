{
	"compilerOptions": {
		// "baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "dom"],
		"target": "esnext",

		"strict": true,
		"noEmit": true,

		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,

		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["node_modules", "dist"]
}
